# Ignore all hidden root directories
/.*/
!/.github/
!/.github/workflows/
!/.github/workflows/release.yml
!/.github/workflows/compatibility.yml

.bundle/
/vendor/bundle/
/.idea/
/.wi*
/.yardoc
/_yardoc/
/coverage/
/doc/
/pkg/
/spec/reports/
/tmp/

# rspec failure tracking
.rspec_status

# Debug files
.byebug*
*.gem

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/

# Test artifacts
/spec/fixtures/tmp/
